<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proses_Telemetri" targetNamespace="https://github.com/muhamadivan1/pantau-distribusi/bpmn">
  <bpmn:collaboration id="Collab_Proses_Telemetri">
    <bpmn:participant id="Pool_Proses_Telemetri" name="Penerimaan telemetri dari berbagai format" processRef="Proses_Telemetri" />
  </bpmn:collaboration>
  <bpmn:process id="Proses_Telemetri" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proses_Telemetri">
      <bpmn:lane id="Lane_Proses_Telemetri_0" name="Gateway perangkat">
        <bpmn:flowNodeRef>Proses_Telemetri_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_Telemetri_1" name="API Pantau Distribusi">
        <bpmn:flowNodeRef>Proses_Telemetri_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_e401</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_e422</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_erej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Telemetri_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Proses_Telemetri_s1" name="Data ukur terkumpul">
      <bpmn:outgoing>Proses_Telemetri_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Proses_Telemetri_t1" name="Kirim POST /telemetry dengan X-API-Key">
      <bpmn:incoming>Proses_Telemetri_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Proses_Telemetri_g1" name="API key benar?">
      <bpmn:incoming>Proses_Telemetri_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Proses_Telemetri_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Proses_Telemetri_e401" name="Ditolak 401">
      <bpmn:incoming>Proses_Telemetri_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Proses_Telemetri_g2" name="Format dikenali adapter?">
      <bpmn:incoming>Proses_Telemetri_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Proses_Telemetri_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Proses_Telemetri_e422" name="Ditolak 422">
      <bpmn:incoming>Proses_Telemetri_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Proses_Telemetri_t2" name="Ubah ke bentuk kanonik lewat adapter">
      <bpmn:incoming>Proses_Telemetri_Flow_5</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Proses_Telemetri_t3" name="Validasi rentang dan cek duplikat">
      <bpmn:incoming>Proses_Telemetri_Flow_7</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Proses_Telemetri_g3" name="Rekaman lolos?">
      <bpmn:incoming>Proses_Telemetri_Flow_8</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Proses_Telemetri_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Proses_Telemetri_erej" name="Dilaporkan sebagai ditolak">
      <bpmn:incoming>Proses_Telemetri_Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Proses_Telemetri_t4" name="Simpan pengukuran">
      <bpmn:incoming>Proses_Telemetri_Flow_9</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Proses_Telemetri_t5" name="Perbarui status, alarm, dan gangguan">
      <bpmn:incoming>Proses_Telemetri_Flow_11</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Proses_Telemetri_t6" name="Terima ringkasan hasil">
      <bpmn:incoming>Proses_Telemetri_Flow_12</bpmn:incoming>
      <bpmn:outgoing>Proses_Telemetri_Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Proses_Telemetri_e1" name="Telemetri diproses">
      <bpmn:incoming>Proses_Telemetri_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_1" sourceRef="Proses_Telemetri_s1" targetRef="Proses_Telemetri_t1" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_2" sourceRef="Proses_Telemetri_t1" targetRef="Proses_Telemetri_g1" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_3" name="Ya" sourceRef="Proses_Telemetri_g1" targetRef="Proses_Telemetri_g2" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_4" name="Tidak" sourceRef="Proses_Telemetri_g1" targetRef="Proses_Telemetri_e401" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_5" name="Ya" sourceRef="Proses_Telemetri_g2" targetRef="Proses_Telemetri_t2" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_6" name="Tidak" sourceRef="Proses_Telemetri_g2" targetRef="Proses_Telemetri_e422" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_7" sourceRef="Proses_Telemetri_t2" targetRef="Proses_Telemetri_t3" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_8" sourceRef="Proses_Telemetri_t3" targetRef="Proses_Telemetri_g3" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_9" name="Ya" sourceRef="Proses_Telemetri_g3" targetRef="Proses_Telemetri_t4" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_10" name="Tidak" sourceRef="Proses_Telemetri_g3" targetRef="Proses_Telemetri_erej" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_11" sourceRef="Proses_Telemetri_t4" targetRef="Proses_Telemetri_t5" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_12" sourceRef="Proses_Telemetri_t5" targetRef="Proses_Telemetri_t6" />
    <bpmn:sequenceFlow id="Proses_Telemetri_Flow_13" sourceRef="Proses_Telemetri_t6" targetRef="Proses_Telemetri_e1" />
  </bpmn:process>
