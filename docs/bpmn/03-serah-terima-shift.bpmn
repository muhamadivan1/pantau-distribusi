<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proses_SerahTerima" targetNamespace="https://github.com/muhamadivan1/pantau-distribusi/bpmn">
  <bpmn:collaboration id="Collab_Proses_SerahTerima">
    <bpmn:participant id="Pool_Proses_SerahTerima" name="Serah terima shift operator" processRef="Proses_SerahTerima" />
  </bpmn:collaboration>
  <bpmn:process id="Proses_SerahTerima" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proses_SerahTerima">
      <bpmn:lane id="Lane_Proses_SerahTerima_0" name="Operator shift lama">
        <bpmn:flowNodeRef>Proses_SerahTerima_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_SerahTerima_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_SerahTerima_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_SerahTerima_t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_SerahTerima_1" name="Sistem Pantau Distribusi">
        <bpmn:flowNodeRef>Proses_SerahTerima_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_SerahTerima_2" name="Operator shift baru">
        <bpmn:flowNodeRef>Proses_SerahTerima_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_SerahTerima_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_SerahTerima_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_SerahTerima_e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Proses_SerahTerima_s1" name="Shift akan berakhir">
      <bpmn:outgoing>Proses_SerahTerima_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Proses_SerahTerima_t1" name="Buka halaman Serah terima">
      <bpmn:incoming>Proses_SerahTerima_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Proses_SerahTerima_Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Proses_SerahTerima_t2" name="Susun ringkasan dari alarm, gangguan, dan beban">
      <bpmn:incoming>Proses_SerahTerima_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Proses_SerahTerima_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Proses_SerahTerima_t3" name="Lengkapi penyebab gangguan yang belum diisi">
      <bpmn:incoming>Proses_SerahTerima_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Proses_SerahTerima_Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Proses_SerahTerima_t4" name="Salin teks ringkasan ke grup operator">
      <bpmn:incoming>Proses_SerahTerima_Flow_4</bpmn:incoming>
      <bpmn:outgoing>Proses_SerahTerima_Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Proses_SerahTerima_t5" name="Baca ringkasan dan alarm yang belum dikonfirmasi">
      <bpmn:incoming>Proses_SerahTerima_Flow_5</bpmn:incoming>
      <bpmn:outgoing>Proses_SerahTerima_Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Proses_SerahTerima_g1" name="Ada gangguan masih terbuka?">
      <bpmn:incoming>Proses_SerahTerima_Flow_6</bpmn:incoming>
      <bpmn:outgoing>Proses_SerahTerima_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Proses_SerahTerima_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Proses_SerahTerima_t6" name="Lanjutkan penanganan gangguan">
      <bpmn:incoming>Proses_SerahTerima_Flow_7</bpmn:incoming>
      <bpmn:outgoing>Proses_SerahTerima_Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Proses_SerahTerima_e1" name="Shift baru berjalan">
      <bpmn:incoming>Proses_SerahTerima_Flow_8</bpmn:incoming>
      <bpmn:incoming>Proses_SerahTerima_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_1" sourceRef="Proses_SerahTerima_s1" targetRef="Proses_SerahTerima_t1" />
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_2" sourceRef="Proses_SerahTerima_t1" targetRef="Proses_SerahTerima_t2" />
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_3" sourceRef="Proses_SerahTerima_t2" targetRef="Proses_SerahTerima_t3" />
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_4" sourceRef="Proses_SerahTerima_t3" targetRef="Proses_SerahTerima_t4" />
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_5" sourceRef="Proses_SerahTerima_t4" targetRef="Proses_SerahTerima_t5" />
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_6" sourceRef="Proses_SerahTerima_t5" targetRef="Proses_SerahTerima_g1" />
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_7" name="Ya" sourceRef="Proses_SerahTerima_g1" targetRef="Proses_SerahTerima_t6" />
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_8" name="Tidak" sourceRef="Proses_SerahTerima_g1" targetRef="Proses_SerahTerima_e1" />
    <bpmn:sequenceFlow id="Proses_SerahTerima_Flow_9" sourceRef="Proses_SerahTerima_t6" targetRef="Proses_SerahTerima_e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Proses_SerahTerima">
