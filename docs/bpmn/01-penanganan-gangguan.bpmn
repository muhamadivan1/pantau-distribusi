<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Proses_Gangguan" targetNamespace="https://github.com/muhamadivan1/pantau-distribusi/bpmn">
  <bpmn:collaboration id="Collab_Proses_Gangguan">
    <bpmn:participant id="Pool_Proses_Gangguan" name="Penanganan gangguan penyulang" processRef="Proses_Gangguan" />
  </bpmn:collaboration>
  <bpmn:process id="Proses_Gangguan" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proses_Gangguan">
      <bpmn:lane id="Lane_Proses_Gangguan_0" name="Operator ruang kendali">
        <bpmn:flowNodeRef>Proses_Gangguan_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Gangguan_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Gangguan_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Gangguan_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Gangguan_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_Gangguan_1" name="Sistem Pantau Distribusi">
        <bpmn:flowNodeRef>Proses_Gangguan_s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Gangguan_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Gangguan_t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Proses_Gangguan_2" name="Regu lapangan">
        <bpmn:flowNodeRef>Proses_Gangguan_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Gangguan_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proses_Gangguan_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Proses_Gangguan_s1" name="Tegangan penyulang hilang">
      <bpmn:outgoing>Proses_Gangguan_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Proses_Gangguan_t1" name="Buka gangguan dan alarm padam otomatis">
      <bpmn:incoming>Proses_Gangguan_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Proses_Gangguan_t2" name="Konfirmasi alarm">
      <bpmn:incoming>Proses_Gangguan_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Proses_Gangguan_t3" name="Perintahkan regu memeriksa jaringan">
      <bpmn:incoming>Proses_Gangguan_Flow_3</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Proses_Gangguan_t4" name="Telusuri jaringan dan temukan penyebab">
      <bpmn:incoming>Proses_Gangguan_Flow_4</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Proses_Gangguan_g1" name="Bisa dipulihkan cepat?">
      <bpmn:incoming>Proses_Gangguan_Flow_5</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Proses_Gangguan_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Proses_Gangguan_t6" name="Manuver jaringan ke penyulang lain">
      <bpmn:incoming>Proses_Gangguan_Flow_7</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Proses_Gangguan_t5" name="Perbaiki penyebab gangguan">
      <bpmn:incoming>Proses_Gangguan_Flow_6</bpmn:incoming>
      <bpmn:incoming>Proses_Gangguan_Flow_8</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Proses_Gangguan_t7" name="Tegangan kembali, gangguan ditutup otomatis">
      <bpmn:incoming>Proses_Gangguan_Flow_9</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Proses_Gangguan_t8" name="Lengkapi penyebab gangguan">
      <bpmn:incoming>Proses_Gangguan_Flow_10</bpmn:incoming>
      <bpmn:outgoing>Proses_Gangguan_Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Proses_Gangguan_e1" name="Data siap dihitung ke SAIDI dan SAIFI">
      <bpmn:incoming>Proses_Gangguan_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_1" sourceRef="Proses_Gangguan_s1" targetRef="Proses_Gangguan_t1" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_2" sourceRef="Proses_Gangguan_t1" targetRef="Proses_Gangguan_t2" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_3" sourceRef="Proses_Gangguan_t2" targetRef="Proses_Gangguan_t3" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_4" sourceRef="Proses_Gangguan_t3" targetRef="Proses_Gangguan_t4" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_5" sourceRef="Proses_Gangguan_t4" targetRef="Proses_Gangguan_g1" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_6" name="Ya" sourceRef="Proses_Gangguan_g1" targetRef="Proses_Gangguan_t5" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_7" name="Tidak" sourceRef="Proses_Gangguan_g1" targetRef="Proses_Gangguan_t6" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_8" sourceRef="Proses_Gangguan_t6" targetRef="Proses_Gangguan_t5" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_9" sourceRef="Proses_Gangguan_t5" targetRef="Proses_Gangguan_t7" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_10" sourceRef="Proses_Gangguan_t7" targetRef="Proses_Gangguan_t8" />
    <bpmn:sequenceFlow id="Proses_Gangguan_Flow_11" sourceRef="Proses_Gangguan_t8" targetRef="Proses_Gangguan_e1" />
  </bpmn:process>
