    "/api/v1/telemetry": {
      "post": {
        "tags": [
          "Telemetri"
        ],
        "summary": "Kirim telemetri dalam format apa pun yang didukung",
        "description": "Format dikenali otomatis dari isi payload. Rekaman yang ditolak tetap dilaporkan beserta alasannya.",
        "operationId": "post_telemetry_api_v1_telemetry_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Payload"
              },
              "examples": {
                "rtu-ioa": {
                  "summary": "RTU gardu induk (titik ukur IOA)",
                  "value": {
                    "rtu": "RTU-GI-DEMO-UTARA",
                    "timestamp": "2026-11-25T08:00:00+07:00",
                    "points": [
                      {
                        "ioa": 1001,
                        "value": 245.3
                      },
                      {
                        "ioa": 1002,
                        "value": 20.1
                      },
                      {
                        "ioa": 1003,
                        "value": 7.69
                      }
                    ]
                  }
                },
                "modbus": {
                  "summary": "IED penyulang (register Modbus)",
                  "value": {
                    "device": "IED-PYL-04",
                    "feeder": "PYL-04",
                    "ts_epoch": 1795568400,
                    "registers": {
                      "40001": 2453,
                      "40002": 2010,
                      "40003": 769
                    }
                  }
                },
                "csv-meter": {
                  "summary": "Ekspor CSV sistem meter",
                  "value": {
                    "content": "penyulang;waktu;arus_a;tegangan_kv;daya_mw\nPYL-06;25/11/2026 08:00:00;210,50;20,10;6,59"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alarms": {
      "get": {
        "tags": [
