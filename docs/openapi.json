              "title": "Status"
            },
            "description": "open = belum selesai, all = termasuk yang sudah normal"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
